# Copy to .env and adjust. .env is gitignored and never committed.

# Secret token baked into the runtime image at build time (random filename inside
# PIXELFORGE_FLAG_DIR). Replace with your deployment value.
FLAG=THJCC{replace_me_with_real_value}

# Human Shield tuning
CAPTCHA_MODE=arith      # arith | text
CAPTCHA_TTL=90          # seconds a verification token stays valid
CAPTCHA_ON_FIRE=true    # true = token is single-use (burned after one render)

# Staging-banner verbosity: 0 none | 1 banners | 2 +notes | 3 +headers
INJECTION_LEVEL=2
